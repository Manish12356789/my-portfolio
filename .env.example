NEXT_PUBLIC_HOST_URL=http://localhost:3000

# Optional - set to your GA4 measurement id (e.g. G-XXXXXXX) to enable
# Google Analytics. Left unset, analytics is skipped entirely.
NEXT_PUBLIC_GA_ID=

# Server-only secret - do NOT add a NEXT_PUBLIC_ prefix to this one.
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Contact form routing (used by pages/api/sendgrid.ts)
CONTACT_RECEIVER_EMAIL=reciver@gmail.com
CONTACT_SENDER_EMAIL=sender@domain.com
